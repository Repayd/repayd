# Public canonical URL used by metadata, OG tags, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only URLs. Keep these out of NEXT_PUBLIC_* variables.
# The API service should expose /v1/atlas/overview.
REPAYD_API_URL=https://api.your-domain.example
# The persistent Bun dashboard should expose /api/demo/state and /api/demo/run.
REPAYD_DASHBOARD_URL=https://runner.your-domain.example
# Shared server-only bearer token for Vercel → remote Bun dashboard control.
REPAYD_RUNNER_TOKEN=generate-a-long-random-value
